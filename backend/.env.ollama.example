# Development only. Copy these values into backend/.env.
APP_EA_EXECUTION_MODE=ollama
# Replace with an exact locally downloaded model name from: ollama list
APP_OLLAMA_MODEL=replace-with-your-local-model
APP_OLLAMA_BASE_URL=http://localhost:11434/v1
APP_OLLAMA_MAX_OUTPUT_TOKENS=4000
APP_OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# Switch to local for local agent execution with Azure Foundry inference;
# switch to hosted for the deployed Azure Foundry agent.
# Search web is explicitly blocked in ollama mode.
