APP_NAME="Enterprise Guardrails API"
APP_ENVIRONMENT=local
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
APP_SQL_SERVER=enterprise-guardrails-server-dev.database.windows.net
APP_SQL_DATABASE=enterprise-guardrails-db-dev
APP_SQL_AUTH_MODE=azure_cli
APP_SQL_ODBC_DRIVER="ODBC Driver 18 for SQL Server"
APP_DEFAULT_RAI_UPN=chriscawthon@dupont.com
APP_STORAGE_ACCOUNT=egstorageadlshn
APP_STORAGE_CONTAINER=project-artifacts
APP_STORAGE_AUTH_MODE=azure_cli
# APP_STORAGE_AUTH_MODE=managed_identity
# User assigned managed identity.
# APP_STORAGE_MANAGED_IDENTITY_CLIENT_ID=<identity-client-id>
# FOUNDRY_PROJECT_ENDPOINT=https://eg-foundry-main.services.ai.azure.com/api/projects/enterprise-guardrails
# FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.5
APP_EA_AGENT_NAME=enterprise-architecture-agent
APP_EA_AGENT_VERSION=5
APP_EA_EXECUTION_MODE=ollama #hosted is default, local is for local development using azure, ollama
APP_SECURITY_EXECUTION_MODE=ollama
APP_OLLAMA_MODEL= gemma4:latest #gpt-oss:20b
APP_OLLAMA_BASE_URL=http://localhost:11434/v1
APP_OLLAMA_MAX_OUTPUT_TOKENS=9000
APP_OLLAMA_REQUEST_TIMEOUT_SECONDS=120
EA_DIAGRAM_MCP_URL=http://127.0.0.1:9000/mcp
EA_DIAGRAM_TOKEN="local-test-token"
# RAI question generation and chat use the FOUNDRY_* settings above.
# Set the Search endpoint and index in backend/.env to enable RAI retrieval.
# Uses standard chunk_id, parent_id, chunk, title and text_vector index fields.
# APP_RAI_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# APP_RAI_SEARCH_INDEX=rai-policy-index
# APP_RAI_SEARCH_AUTH_MODE=azure_cli
# APP_RAI_SEARCH_MANAGED_IDENTITY_CLIENT_ID=
# APP_RAI_SEARCH_VECTOR_FIELD=text_vector
# APP_RAI_SEARCH_TIMEOUT_SECONDS=15

# Print RAI search query, full prompt/context/excerpts and generated questions to the backend log.
# Contains project and reference-document content. Enable for debugging when needed.
APP_RAI_LOG_PROMPTS=false
