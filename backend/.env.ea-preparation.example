# Add to your existing backend .env; do not replace its SQL/SSO/storage settings.
# Pin to the successfully deployed and smoke-tested Foundry agent version.
APP_EA_AGENT_NAME=enterprise-architecture-agent
APP_EA_AGENT_VERSION=3

# Already configured for your EA agent:
FOUNDRY_PROJECT_ENDPOINT=https://eg-foundry-main.services.ai.azure.com/api/projects/enterprise-guardrails
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.5
FOUNDRY_AUTH_MODE=azure_cli
# In Azure, use FOUNDRY_AUTH_MODE=managed_identity.
# Optional for a user-assigned identity (omit for system-assigned identity):
# FOUNDRY_MANAGED_IDENTITY_CLIENT_ID=<backend-managed-identity-client-id>
