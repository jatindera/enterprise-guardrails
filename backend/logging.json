{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "plain": {
      "format": "%(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "plain",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "guardrails.api": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["console"],
      "level": "WARNING",
      "propagate": false
    }
  }
}